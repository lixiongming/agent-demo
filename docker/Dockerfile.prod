# ============================================
# Docker 配置 - 生产环境
# Python 版本: 3.12.10
# ============================================

# 基础镜像 - 使用 slim 版本（最小化）
FROM python:3.12-slim AS base

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # 生产环境标志
    ENVIRONMENT=production

WORKDIR /app

# ============================================
# 构建阶段 - 安装依赖（单独层，利用缓存）
# ============================================
FROM base AS builder

# 安装编译依赖（某些 Python 包需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 复制 pip 配置文件（使用国内镜像）
COPY docker/pip.conf /root/.pip/pip.conf

# 复制依赖文件（单独复制，利用 Docker 缓存）
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# ============================================
# 运行阶段 - 最终镜像
# ============================================
FROM base AS runner

# 从构建阶段复制依赖
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 安装运行时依赖（curl 用于 healthcheck）
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户（安全最佳实践）
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

# 创建必要目录
RUN mkdir -p logs && chown -R appuser:appuser /app

# 复制应用代码
COPY --chown=appuser:appuser app ./app

# 切换到非 root 用户
USER appuser

# 暴露端口
EXPOSE 8888

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8888/api/v1/health/health || exit 1

# 生产环境启动命令（多 worker，无热更新）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8888", "--workers", "4"]
