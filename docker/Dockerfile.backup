# ============================================
# MySQL 定时备份服务镜像（生产级）
# ============================================
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    cron \
    mysql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ops/backup_mysql.sh /app/ops/backup_mysql.sh
COPY ops/restore_mysql.sh /app/ops/restore_mysql.sh
COPY ops/start_cron.sh /app/ops/start_cron.sh

RUN chmod +x /app/ops/backup_mysql.sh \
    && chmod +x /app/ops/restore_mysql.sh \
    && chmod +x /app/ops/start_cron.sh

# 设置 cron 定时任务：每天凌晨 2:00 执行备份
RUN echo "0 2 * * * /app/ops/backup_mysql.sh >> /app/logs/backup.log 2>&1" | crontab -

RUN mkdir -p /app/logs /app/data/backups

# 创建非 root 用户
RUN groupadd -r backupuser && useradd -r -g backupuser -d /app -s /sbin/nologin backupuser \
    && chown -R backupuser:backupuser /app

USER backupuser

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD pgrep cron > /dev/null || exit 1

CMD ["/app/ops/start_cron.sh"]
