# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并修改配置
# ============================================

# LLM 配置（必须设置）
DASHSCOPE_API_KEY=your_api_key_here

# MySQL 配置（Docker 内部使用）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agent_db

# 本地开发 MySQL 配置（如果使用本地 MySQL）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant 配置
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# Embedding 配置
EMBEDDING_MODEL_NAME=bge-large-zh-v1.5

# Agent 配置
MAX_ITERATIONS=10
AGENT_TIMEOUT=60