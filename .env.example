# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并修改配置
# ============================================

# LLM 配置（阿里云 DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ============================================
# Embedding 配置（支持多种 Provider）
# ============================================
# EMBEDDING_PROVIDER: 选择 Embedding 服务提供商
#   - zhipu: 智谱 AI embedding-3（推荐中文场景）
#   - openai: OpenAI text-embedding-3-small/large
#   - local: 本地模型（如 BGE）
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL_NAME=embedding-3
EMBEDDING_API_KEY=your_embedding_api_key_here

# OpenAI Base URL（可选，仅 EMBEDDING_PROVIDER=openai 时使用）
# OPENAI_BASE_URL=https://api.openai.com/v1

# MySQL 配置（Docker 内部使用）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agent_db

# 本地开发 MySQL 配置（如果使用本地 MySQL）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant 配置
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# Agent 配置
MAX_ITERATIONS=10
AGENT_TIMEOUT=60

# 对话历史配置（大厂标准做法）
HISTORY_ENABLED=true  # 是否加载历史消息
HISTORY_MODE=token  # 模式: rounds(按轮数) / token(按token数，推荐)
HISTORY_ROUNDS_LIMIT=10  # 轮数模式: 保留最近 N 轮对话（1轮=1问1答）
HISTORY_TOKEN_LIMIT=16000  # Token模式: 历史消息最大 token 数（32K上下文，预留一半给输出）
HISTORY_TOKEN_SAFETY_MARGIN=500  # Token 安全边界

# ============================================
# 天气 API 配置（和风天气）
# ============================================
# API Host: 请替换为你的实际API地址
QWEATHER_API_HOST=https://devapi.qweather.com
# API Token: 请替换为你的实际Token
QWEATHER_API_TOKEN=your_token_here
# 默认城市代码（北京: 101010100）
QWEATHER_DEFAULT_LOCATION=101010100