# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并修改配置
# ============================================

# 环境类型: development / staging / production
ENVIRONMENT=development

# 管理接口 Token（生产环境必须修改）
ADMIN_TOKEN=admin-token-change-me-in-production

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-here  # 必须修改，建议使用 32+ 字符随机字符串
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120  # Access Token 过期时间（默认2小时）
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7  # Refresh Token 过期时间（默认7天）

# CORS 配置（生产环境应限制为具体域名）
# CORS_ORIGINS=*  # 开发环境用 *，生产环境如: https://a.com,https://b.com

# LLM 配置（阿里云 DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ============================================
# Embedding 配置（支持多种 Provider）
# ============================================
# EMBEDDING_PROVIDER: 选择 Embedding 服务提供商
#   - zhipu: 智谱 AI embedding-3（推荐中文场景）
#   - openai: OpenAI text-embedding-3-small/large
#   - local: 本地模型（如 BGE）
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL_NAME=embedding-3
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_DIM=2048  # 向量维度（智谱 embedding-3 = 2048）

# 智谱 AI 配置（用于 Embedding 和 Rerank）
ZHIPU_API_KEY=your_zhipu_api_key_here

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456  # 生产环境必须修改
MYSQL_DATABASE=agent_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant 配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# Agent 配置
MAX_ITERATIONS=10
AGENT_TIMEOUT=60

# 对话历史配置
HISTORY_ENABLED=true
HISTORY_MODE=token
HISTORY_ROUNDS_LIMIT=10
HISTORY_TOKEN_LIMIT=16000
HISTORY_TOKEN_SAFETY_MARGIN=500

# ============================================
# 天气 API 配置（和风天气）
# ============================================
QWEATHER_API_HOST=https://devapi.qweather.com
QWEATHER_API_TOKEN=your_token_here
QWEATHER_DEFAULT_LOCATION=101010100

# 日志配置
LOG_LEVEL=INFO
# DEBUG=false  # 生产环境设为 false
